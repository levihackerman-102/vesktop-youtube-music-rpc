DISCORD_CLIENT_ID=your_discord_application_id_here

# Optional: comma-separated list of non-Steam game process names to detect.
# The bridge will pause YouTube Music RPC while any of these processes are running.
# Steam games are detected automatically — you only need this for non-Steam games.
# Example: GAME_PROCESSES=cyberpunk2077,eldenring,minecraft
# GAME_PROCESSES=
